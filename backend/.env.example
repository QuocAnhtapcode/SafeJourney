DATABASE_URL=postgresql://journey:journey_local_change_me@127.0.0.1:5432/journey
REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
DEMO_PASSWORD=
# DEMO thresholds, not real-world safety thresholds.
STOP_SECONDS=15
DEVIATION_SECONDS=12
SPEED_SECONDS=9
GPS_LOST_SECONDS=45
SPEED_LIMIT_KMH=80
LLM_MODE=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Local cold starts may take tens of seconds; alerts do not wait for the LLM.
LLM_TIMEOUT_SECONDS=60
INCIDENT_LEASE_SECONDS=300
# Set only when hosted PostgreSQL supplies a separate direct URL.
# CHECKPOINT_DATABASE_URL=

# Per-process pool; total connections = sum across API/detector/planner processes.
DB_POOL_MIN=2
DB_POOL_MAX=16
DB_POOL_TIMEOUT=5
DB_POOL_MAX_WAITING=64
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FRESH_SECONDS=30
WATCHDOG_INTERVAL_SECONDS=5

# Operations sandbox: empty uses labeled straight-line estimates, never road validation.
# Use your own OSRM service. Trip coordinates are sent only to this configured host.
OSRM_URL=
OSRM_TIMEOUT_SECONDS=3
# Optional local LLM selects specialist order only; all specialists/tools still run.
OPERATIONS_LLM_MODE=mock
OPERATIONS_LLM_TIMEOUT_SECONDS=8
