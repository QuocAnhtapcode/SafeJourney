app = "REPLACE_WITH_YOUR_UNIQUE_APP_NAME"
primary_region = "sin"
[build]
  dockerfile = "Dockerfile"

[env]
  COOKIE_SECURE = "true"
  ALLOWED_ORIGINS = "https://REPLACE_WITH_YOUR_UNIQUE_APP_NAME.fly.dev"
  LLM_MODE = "mock"
  STOP_SECONDS = "15"
  DEVIATION_SECONDS = "12"
  SPEED_SECONDS = "9"
  GPS_LOST_SECONDS = "45"

[processes]
  web = "uvicorn app.main:app --host 0.0.0.0 --port 8080"
  detector = "python -m app.worker"
  planner = "python -m app.planner"

[deploy]
  release_command = "python -m app.db"

[http_service]
  internal_port = 8080
  processes = ["web"]
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = false

[[http_service.checks]]
  interval = "15s"
  timeout = "5s"
  grace_period = "20s"
  method = "GET"
  path = "/api/health"

[[vm]]
  memory = "1gb"
  cpu_kind = "shared"
  cpus = 1
